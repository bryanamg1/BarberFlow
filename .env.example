# Copy to .env for local setup; .env.local can override values for this machine.
# All variables below are public and visible in the compiled Expo app.
# Never put service-role, secret API keys or database passwords in EXPO_PUBLIC_*.

# Supabase client (required on all platforms; both values must target the same project)
EXPO_PUBLIC_SUPABASE_URL=
# Public anon JWT or publishable client key, never a service-role/secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Auth / Recovery (public; required only for Web recovery)
# Full HTTP(S) URL ending in /auth/recovery, without credentials, query or fragment.
# Approved production callback; authorize the exact environment URL in Supabase Auth.
# Other environments require their own explicit approved callback, never an inferred preview URL.
# No Web fallback. Native remains barberflow://auth/recovery, outside env.
EXPO_PUBLIC_AUTH_RECOVERY_REDIRECT_URL=https://barberflow.expo.app/auth/recovery
